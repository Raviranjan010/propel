# KSPDB Automated Fault Localization System — Environment Configuration Example

# Node HTTP Server Port (Ingestion API & SCADA Console)
PORT=8000

# PostgreSQL Database Connection String
DATABASE_URL=postgresql://kspdb:kspdb_pass@db:5432/kspdb_db

# PostgreSQL Credentials (used by docker-compose)
POSTGRES_USER=kspdb
POSTGRES_PASSWORD=kspdb_pass
POSTGRES_DB=kspdb_db

# LLM API Key for SCADA Operator Copilot Dispatch Briefings
# Optional. If omitted or unset, the system seamlessly falls back to a deterministic briefing template.
LLM_API_KEY=

# Synthetic Network Generator Settings
SEED_POLE_COUNT=5000
UNMAPPED_TOPOLOGY_RATIO=0.60
