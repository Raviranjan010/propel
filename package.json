{
  "name": "kspdb-fault-locator",
  "version": "1.0.0",
  "description": "KSPDB Automated Fault Localization System",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc && node -e \"fs.mkdirSync('dist/db', {recursive: true}); fs.copyFileSync('src/db/schema.sql', 'dist/db/schema.sql')\"",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "test": "vitest run",
    "seed": "tsx src/db/seed.ts",
    "topology:build": "tsx src/services/topologyBuilder.ts",
    "db:init": "tsx src/db/init.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.2.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "pg": "^8.12.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.9",
    "@types/pg": "^8.11.6",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0",
    "tsx": "^4.16.2",
    "typescript": "^5.5.2",
    "vitest": "^1.6.0"
  }
}
